# ---- App ----
BASE_URL=http://localhost:8086
SERVER_NAME=mural-mcp
HOST=127.0.0.1
PORT=8086
# PYTHON_ENV=development
# LOG_CONFIG=logging-dev.json

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=mural-mcp
# MONGO_TRUSTSTORE=TRUSTSTORE_CDP_ROOT_CA

# ---- Resource guard ----
# "allow_all" (default) lets every board request through; the access-request
# workflow below still records requests/decisions but nothing is enforced.
# "allow_list" denies a board unless an approved BoardAccessRequest exists for
# the (user, board) pair. Flip only once the admin surface has real approvals
# to check against -- flipping first denies all traffic.
RESOURCE_GUARD_MODE=allow_all
# ACCESS_REQUEST_COLLECTION=board_approvals

# ---- Identity: this server mints and verifies its own personal access
# tokens (PATs). There is no external IdP call on the request path -- the
# portal authenticates the user against Entra on its own, then calls this
# server's trusted-header surface to mint a token, and hands that token to
# the user for one-time viewing.
#
# REST_AUTH_MODE governs the admin/REST surface (not /mcp, which always
# requires a bearer PAT):
#   trusted (default) - no token auth; trust the caller to assert the user via
#                        TRUSTED_USER_HEADER. Use only when this surface is on
#                        a locked-down backend network reachable solely from
#                        the portal.
#   token              - require a bearer PAT, same as /mcp.
# The token-mint/list/revoke surface (POST/GET/DELETE /tokens) always uses
# the trusted header regardless of this setting.
REST_AUTH_MODE=trusted
TRUSTED_USER_HEADER=X-User-Id

# IDENTITY_TOKEN_PREFIX=mmcp_
# IDENTITY_DEFAULT_TTL_DAYS=90
# IDENTITY_MAX_TTL_DAYS=365
# IDENTITY_LAST_USED_THROTTLE_SECONDS=300
# USER_COLLECTION=users
# PAT_COLLECTION=personal_access_tokens

# ---- Mural OAuth (server -> Mural API) ----
# MURAL_API_BASE=https://app.mural.co/api
# MURAL_AUTHORIZE_PATH=/public/v1/authorization/oauth2/
# MURAL_TOKEN_PATH=/public/v1/authorization/oauth2/token
# MURAL_SCOPES=murals:read identity:read
MURAL_CLIENT_ID=your-mural-client-id
MURAL_CLIENT_SECRET=your-mural-client-secret
# Appended to BASE_URL to form the redirect_uri, and the path this server's
# callback route listens on.
MURAL_CALLBACK_PATH=/connect/mural/callback
# MURAL_TOKEN_COLLECTION=mural_tokens
# MURAL_OAUTH_STATE_COLLECTION=oauth_states

# Local dev auth: no bypass. Mint a token against the running service --
#   curl -XPOST localhost:8086/tokens -H "X-User-Id: dev@example.com" -d '{"label":"local"}'
# and use the returned token as a Bearer token against /mcp or any other route.
